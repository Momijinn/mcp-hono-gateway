# Copy to .env and fill in if you need AWS auth for the pricing MCP server
BEARER_TOKEN=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CONTEXT7_API_KEY=

TAVILY_API_KEY=

CLOUDFLARED_TUNNEL_TOKEN=

# --- MCP session/memory controls (optional) ---
# Cap concurrent sessions to avoid accumulating child processes.
MCP_MAX_SESSIONS=10

# Auto-cleanup sessions that are idle for this long (ms). Set 0 to disable.
MCP_SESSION_IDLE_MS=300000

# Auto-cleanup sessions older than this (ms). Set 0 to disable.
MCP_SESSION_MAX_LIFETIME_MS=3600000

# Reject oversized initialize JSON bodies (bytes).
MCP_MAX_INIT_BODY_BYTES=250000

# Log sessions/memory usage every minute when set to 1.
MCP_LOG_MEMORY=
